{
  "name": "sias-ai-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=26.8.1 <27",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "vite --config vite.admin.config.ts",
    "preview": "vite preview --config vite.admin.config.ts",
    "check": "tsc -p tsconfig.admin.json --noEmit",
    "test": "vitest run --config vite.admin.config.ts",
    "build": "npm run check && vite build --config vite.admin.config.ts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "iconoir-react": "7.12.1",
    "jszip": "3.10.1",
    "pinyin-pro": "3.29.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
