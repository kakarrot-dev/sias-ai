{
  "name": "sias-ai-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=26.8.1 <27",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "check": "tsc -p tsconfig.web.json --noEmit",
    "check:typography": "node prototypes/macos-client-v2/scripts/check-typography-contract.mjs",
    "check:layout": "node prototypes/macos-client-v2/scripts/check-layout-contract.mjs",
    "test": "vitest run",
    "build": "npm run check && npm run check:typography && npm run check:layout && vite build --config vite.config.ts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "iconoir-react": "7.12.1",
    "react-aria-components": "1.20.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
